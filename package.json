{
  "name": "timer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo/ui": "~58.0.30",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "~58.1.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.6",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^1.49.0",
    "posthog-js": "^1.454.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check": "expo lint && tsc --noEmit && jest --ci --testTimeout=30000",
    "deps:report": "bash scripts/deps-report.sh"
  },
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false,
    "unrs-resolver": false,
    "@parcel/watcher": false
  }
}
